# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/question_bank?schema=public"

# Authentication & Security
APP_AUTH_SECRET="change-me-in-production-min-32-chars-secret-key"
DEFAULT_API_TOKEN="qbank-dev-token-2026"
SIGNED_URL_SECRET="change-me-signed-asset-url-secret-key-2026"

# Redis & Background Queue (BullMQ)
REDIS_URL="redis://localhost:6379"
QUEUE_FALLBACK_IN_PROCESS="true"

# Private Object Storage ("local" or "s3")
STORAGE_PROVIDER="local"
LOCAL_STORAGE_ROOT="./.private-storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="question-bank-private"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Upload & Processing Limits
MAX_FILE_SIZE_BYTES="52428800"
MAX_PAGE_COUNT="200"
MAX_IMAGE_DIMENSION="6000"
PROCESSING_TIMEOUT_MS="300000"

# OCR Configuration ("paddle", "managed", or "tesseract")
OCR_PROVIDER="paddle"
PADDLE_OCR_ENDPOINT="http://localhost:8866/predict/ocr_system"
MANAGED_OCR_ENDPOINT=""
MANAGED_OCR_API_KEY=""
OCR_TIMEOUT_MS="30000"
OCR_MAX_RETRIES="3"
OCR_LOW_CONFIDENCE_THRESHOLD="0.78"

# Selective OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o-mini"
OPENAI_ESCALATION_MODEL="gpt-4o"
AI_REPAIR_CONFIDENCE_THRESHOLD="0.75"
AI_BUDGET_PER_IMPORT_USD="0.50"
AI_MAX_OUTPUT_TOKENS="2048"
